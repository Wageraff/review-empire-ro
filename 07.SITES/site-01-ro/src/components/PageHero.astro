---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<section class="border-b border-border bg-gradient-to-br from-primary via-[#1a2b4a] to-[#152238] text-white">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="font-heading text-2xl font-bold text-accent sm:text-3xl">Betoteca</p>
    <h1 class="font-heading mt-3 max-w-3xl text-3xl font-bold leading-tight sm:text-4xl">
      {title}
    </h1>
    {lede && <p class="mt-4 max-w-2xl text-base text-slate-200 sm:text-lg">{lede}</p>}
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/recenzii/betano/"
        class="rounded bg-accent px-5 py-2.5 text-sm font-semibold text-white no-underline hover:brightness-110"
      >
        Vezi top case
      </a>
      <a
        href="/metodologie/"
        class="rounded border border-white/30 px-5 py-2.5 text-sm font-semibold text-white no-underline hover:bg-white/10"
      >
        Cum evaluăm
      </a>
    </div>
  </div>
</section>
