---
import { NAV, SITE } from '../lib/site';
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="font-heading text-xl font-bold text-primary no-underline">
      {SITE.name}
    </a>
    <nav class="hidden items-center gap-3 lg:flex" aria-label="Principal">
      {
        NAV.map((item) => (
          <a href={item.href} class="text-sm font-semibold text-text no-underline hover:text-accent">
            {item.label}
          </a>
        ))
      }
    </nav>
    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded border border-border px-3 py-1.5 text-sm font-semibold">
        Meniu
      </summary>
      <div class="absolute right-0 z-50 mt-2 w-52 rounded-lg border border-border bg-surface p-2 shadow-lg">
        {
          NAV.map((item) => (
            <a href={item.href} class="block rounded px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-slate-50">
              {item.label}
            </a>
          ))
        }
      </div>
    </details>
    <span class="rounded bg-danger px-2 py-0.5 text-xs font-bold text-white" title="Doar pentru persoane peste 18 ani">
      18+
    </span>
  </div>
</header>
