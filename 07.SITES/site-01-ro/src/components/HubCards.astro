---
interface Props {
  title: string;
  links: { href: string; label: string; desc: string }[];
}

const { title, links } = Astro.props;
---

<section class="my-10">
  <h2 class="font-heading text-2xl font-semibold text-primary">{title}</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      links.map((l) => (
        <a
          href={l.href}
          class="block rounded-lg border border-border bg-surface p-4 no-underline shadow-sm transition hover:border-accent hover:shadow"
        >
          <span class="font-semibold text-primary">{l.label}</span>
          <span class="mt-1 block text-sm text-muted">{l.desc}</span>
        </a>
      ))
    }
  </div>
</section>
