---
interface Row {
  name: string;
  rating: string;
  strength: string;
  license: string;
  href?: string;
  logoSrc?: string;
  affiliateUrl?: string;
  ctaLabel?: string;
}

interface Props {
  rows: Row[];
  caption?: string;
}

const { rows, caption } = Astro.props;
---

<div class="my-8 overflow-x-auto rounded-lg border border-border bg-surface shadow-sm">
  {
    caption && (
      <p class="border-b border-border px-4 py-2 text-sm font-semibold text-primary">{caption}</p>
    )
  }
  <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
    <thead class="sticky top-0 bg-slate-100">
      <tr>
        <th class="px-4 py-3 font-semibold">#</th>
        <th class="px-4 py-3 font-semibold">Operator</th>
        <th class="px-4 py-3 font-semibold">Rating</th>
        <th class="px-4 py-3 font-semibold">Punct forte</th>
        <th class="px-4 py-3 font-semibold">Licență</th>
        <th class="px-4 py-3 font-semibold">Ofertă</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r, i) => (
          <tr class:list={[{ 'bg-slate-50': i % 2 === 1 }, 'hover:bg-amber-50/60']}>
            <td class="px-4 py-3 tabular-nums text-muted">{i + 1}</td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                {r.logoSrc ? (
                  r.href ? (
                    <a href={r.href} class="block shrink-0 no-underline" title={r.name}>
                      <img
                        src={r.logoSrc}
                        alt={r.name}
                        width="120"
                        height="48"
                        class="h-10 w-auto max-w-[7.5rem] object-contain"
                        loading="lazy"
                      />
                      <span class="sr-only">{r.name}</span>
                    </a>
                  ) : (
                    <img
                      src={r.logoSrc}
                      alt={r.name}
                      width="120"
                      height="48"
                      class="h-10 w-auto max-w-[7.5rem] object-contain"
                      loading="lazy"
                    />
                  )
                ) : r.href ? (
                  <a href={r.href} class="font-semibold text-primary no-underline hover:underline">
                    {r.name}
                  </a>
                ) : (
                  <span class="font-semibold text-primary">{r.name}</span>
                )}
              </div>
            </td>
            <td class="px-4 py-3 font-semibold tabular-nums text-primary">{r.rating}</td>
            <td class="px-4 py-3 text-muted">{r.strength}</td>
            <td class="px-4 py-3 text-muted">{r.license}</td>
            <td class="px-4 py-3">
              {r.affiliateUrl ? (
                <a
                  href={r.affiliateUrl}
                  class="inline-block rounded bg-accent px-3 py-1.5 text-xs font-semibold text-white no-underline hover:brightness-110"
                  rel="sponsored noopener noreferrer"
                  target="_blank"
                >
                  {r.ctaLabel || 'Vezi oferta'}
                </a>
              ) : r.href ? (
                <a
                  href={r.href}
                  class="inline-block rounded border border-accent px-3 py-1.5 text-xs font-semibold text-accent no-underline hover:bg-amber-50"
                >
                  Recenzie
                </a>
              ) : null}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="border-t border-border px-4 py-2 text-xs text-muted">
    Linkurile de ofertă pot fi affiliate. 18+ · Joacă responsabil.
  </p>
</div>
